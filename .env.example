# Variables para docker compose. Copiar a .env y completar. El archivo .env no se versiona.
# (Para correr sin Docker, con npm run dev, se usa server/.env: ver server/.env.example.)

MYSQL_ROOT_PASSWORD=cambiar-por-una-clave-larga
SESSION_SECRET=cambiar-por-una-frase-larga-y-secreta

# Cuenta del administrador que se crea la primera vez que arranca la base vacía.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Correo saliente (opcional). Vacío: bandeja de prueba de Ethereal.
MAIL_HOST=
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
