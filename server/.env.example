# Copiá este archivo como .env y completá los valores.

# Servidor
PORT=3001
APP_URL=http://localhost:5173
SESSION_SECRET=cambiar-por-una-frase-larga-y-secreta

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=golden_screen
# Bases en la nube (Aiven): conexión cifrada. DB_SSL_CA es el certificado CA en texto
# PEM (se puede pegar en una sola línea con \n). Sin CA se cifra pero no se verifica.
DB_SSL=false
DB_SSL_CA=
# Zona horaria de la sesión de MySQL (hora del cine).
DB_ZONA_HORARIA=-03:00

# Cuenta inicial del administrador (se crea con npm run db:setup)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Correo saliente. Con Mailtrap, copiá los datos SMTP de tu bandeja de pruebas.
# Si se dejan vacíos, la API crea una bandeja de prueba en Ethereal y muestra
# en la consola el enlace para ver cada correo enviado.
MAIL_HOST=
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Golden Screen Cinema <no-responder@goldenscreen.com.ar>"
